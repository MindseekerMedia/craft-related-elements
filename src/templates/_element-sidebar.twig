<fieldset class="related-elements-sidebar" data-element-id="{{ element.id }}" data-site-id="{{ element.siteId }}">
  <legend class="h6">Related elements</legend>
  <div class="meta">
  {% if references.items|length or referencedBy.items|length %}
    {% for key, title in {references: 'References', referencedBy: 'Referenced by'} %}
      {% set page = attribute(_context, key) %}
      {% if page.items|length %}
    <section class="related-elements-section" data-section="{{ key }}" data-cursor="{{ page.cursor ?? '' }}" data-initial-cursor="{{ page.cursor ?? '' }}">
      <div class="field relationship-section-header">
        <div class="flex flex-nowrap gap-s items-center">
          <strong>{{ title }}</strong>
          <button type="button" class="info-icon-btn" aria-label="About {{ title }}" aria-expanded="false">
            <span class="cp-icon small">{{ iconSvg('info') }}</span>
          </button>
          <div class="info-tooltip hidden" role="tooltip">{{ key == 'references' ? 'Elements this element links to' : 'Elements that link to this element' }}</div>
        </div>
      </div>
      <div class="related-elements-items" aria-live="polite">
        {% include 'related-elements/_items' with {items: page.items, showElementTypeLabel: showElementTypeLabel, loaded: false} only %}
      </div>
      <p class="related-elements-error hidden" role="alert"></p>
      <div class="related-elements-actions{% if not page.hasMore %} hidden{% endif %}">
        <button type="button" class="btn small related-elements-more">Show more {{ key == 'references' ? 'references' : 'referenced by' }}</button>
        <button type="button" class="btn small related-elements-less hidden">Show less</button>
        <span class="spinner hidden" aria-label="Loading"></span>
      </div>
    </section>
      {% endif %}
    {% endfor %}
  {% else %}
    <div class="field flex-1 related-elements-empty"><p>No related elements found.</p></div>
  {% endif %}
  </div>
</fieldset>

{% css %}
.related-elements-section+.related-elements-section{margin-top:12px}.relationship-section-header{position:relative;padding:8px var(--m);margin-bottom:4px;border-radius:4px;background:var(--gray-050)}
.relationship-section-header strong{font-size:14px;color:var(--gray-700)}.info-icon-btn{display:flex;align-items:center;padding:2px;border:0;background:none;color:var(--gray-500);cursor:pointer;opacity:.7}.info-tooltip{position:absolute;top:100%;left:var(--m);z-index:1000;margin-top:4px;padding:8px 12px;border-radius:4px;background:var(--gray-900);color:#fff;font-size:11px;white-space:nowrap}
.related-element-item{margin:0!important;padding-block:8px;padding-inline:var(--m) var(--s)}.related-element-link{display:flex;flex-wrap:nowrap;align-items:center;gap:var(--s);padding-left:var(--m)}
.related-element-title{min-width:0;overflow-wrap:anywhere}.element-type-pill{display:inline-block;padding:0 5px;border:1px solid var(--gray-200);border-radius:8px;color:var(--gray-700);background:var(--gray-050);font-size:8px;line-height:14px;font-weight:500;text-transform:uppercase;letter-spacing:.2px}
.related-elements-sidebar .cp-icon[style*="--icon-color"] svg,.related-elements-sidebar .cp-icon[style*="--icon-color"] svg *{fill:var(--icon-color)!important;stroke:var(--icon-color)!important;color:var(--icon-color)!important}
.related-elements-actions{display:flex;align-items:center;gap:6px;padding:6px var(--m);border-top:0}.related-elements-empty,.related-elements-error{margin:0;padding:10px var(--m)}.related-elements-error{color:var(--red-600)}
{% endcss %}

{% js %}
(() => {
  document.querySelectorAll('.related-elements-sidebar').forEach((sidebar) => {
    if (sidebar.dataset.initialized) return;
    sidebar.dataset.initialized = 'true';
    const requestPage = async (section, cursor) => {
      const error = section.querySelector('.related-elements-error');
      const spinner = section.querySelector('.spinner');
      error.classList.add('hidden'); spinner.classList.remove('hidden');
      section.querySelectorAll('button').forEach((button) => button.disabled = true);
      try {
        const response = await Craft.sendActionRequest('POST', '{{ pageUrl }}', {data: {
          elementId: Number(sidebar.dataset.elementId), siteId: Number(sidebar.dataset.siteId),
            section: section.dataset.section, cursor: cursor || null,
        }});
        return response.data;
      } catch (exception) {
        error.textContent = exception?.response?.data?.message || 'Could not load related elements. Please try again.';
        error.classList.remove('hidden'); return null;
      } finally {
        spinner.classList.add('hidden'); section.querySelectorAll('button').forEach((button) => button.disabled = false);
      }
    };
    const updateControls = (section, data, expanded) => {
      const actions = section.querySelector('.related-elements-actions');
      section.dataset.cursor = data.cursor || '';
      actions.classList.toggle('hidden', !data.hasMore && !expanded);
      section.querySelector('.related-elements-more').classList.toggle('hidden', !data.hasMore);
      section.querySelector('.related-elements-less').classList.toggle('hidden', !expanded);
    };
    sidebar.querySelectorAll('.related-elements-section').forEach((section) => {
      const items = section.querySelector('.related-elements-items');
      section.querySelector('.related-elements-more').addEventListener('click', async () => {
        const data = await requestPage(section, section.dataset.cursor); if (!data) return;
        items.insertAdjacentHTML('beforeend', data.html); updateControls(section, data, true);
      });
      section.querySelector('.related-elements-less').addEventListener('click', () => {
        items.querySelectorAll('[data-loaded="true"]').forEach((item) => item.remove());
        const cursor = section.dataset.initialCursor; updateControls(section, {cursor, hasMore: cursor !== ''}, false);
      });
    });
    sidebar.querySelectorAll('.info-icon-btn').forEach((button) => button.addEventListener('click', () => {
      const tooltip = button.nextElementSibling;
      const expanded = button.getAttribute('aria-expanded') === 'true';
      sidebar.querySelectorAll('.info-tooltip').forEach((item) => item.classList.add('hidden'));
      sidebar.querySelectorAll('.info-icon-btn').forEach((item) => item.setAttribute('aria-expanded', 'false'));
      if (!expanded) { tooltip.classList.remove('hidden'); button.setAttribute('aria-expanded', 'true'); }
    }));
  });
  if (!window.relatedElementsTagListenerAdded) {
    window.relatedElementsTagListenerAdded = true;
    document.addEventListener('click', (event) => {
      const link = event.target.closest('.related-elements-sidebar .tag-link'); if (!link) return;
      event.preventDefault(); Craft.createElementEditor('craft\\elements\\Tag', {elementId: Number(link.dataset.tagId)});
    });
  }
})();
{% endjs %}
