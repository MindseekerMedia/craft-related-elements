{% set labels = {entries: 'Entry', categories: 'Category', assets: 'Asset', tags: 'Tag'} %}
<div class="field related-element-item{% if fieldLabel %} nested-element{% endif %}" data-type="{{ type }}" data-loaded="{{ loaded ? 'true' : 'false' }}">
  {% include '_elements/list' with {
    elements: [element],
    context: 'field',
    size: 'small',
    showActionMenu: true,
  } only %}
  {% if showElementTypeLabel %}<span class="element-type-pill">{{ labels[type] }}</span>{% endif %}
</div>
