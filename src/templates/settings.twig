{% import '_includes/forms.twig' as forms %}

{# Check for config file overrides #}
{% set configFileSettings = craft.app.config.getConfigFromFile('related-elements') %}

<div>
  {{ forms.lightswitchField({
    label: 'Display nested related elements',
    instructions: 'Whether to display the related elements that exist inside the CKEditor, Matrix or Neo fields of an element.',
    name: 'enableNestedElements',
    value: settings.enableNestedElements,
    on: (settings.enableNestedElements is defined) ? settings.enableNestedElements : '',
    class: 'first',
    warning: configFileSettings.enableNestedElements is defined ? 'This setting is being overridden by the "enableNestedElements" setting in your related-elements.php config file.' : null,
    disabled: configFileSettings.enableNestedElements is defined,
  }) }}

  {{ forms.lightswitchField({
    label: 'Show element type labels',
    instructions: 'Whether to display the element type labels (Entry, Category, Asset, Tag) next to each related element.',
    name: 'showElementTypeLabel',
    value: settings.showElementTypeLabel,
    on: (settings.showElementTypeLabel is defined) ? settings.showElementTypeLabel : '',
    warning: configFileSettings.showElementTypeLabel is defined ? 'This setting is being overridden by the "showElementTypeLabel" setting in your related-elements.php config file.' : null,
    disabled: configFileSettings.showElementTypeLabel is defined,
  }) }}

  {{ forms.textField({
    label: 'Initial limit',
    instructions: 'Number of related elements to show initially before requiring "Show More" to expand the list.',
    name: 'initialLimit',
    value: settings.initialLimit,
    type: 'number',
    min: 1,
    max: 100,
    size: 10,
    warning: configFileSettings.initialLimit is defined ? 'This setting is being overridden by the "initialLimit" setting in your related-elements.php config file.' : null,
    disabled: configFileSettings.initialLimit is defined,
  }) }}

  {{ forms.checkboxGroupField({
    label: 'Related element types',
    instructions: 'Choose which kinds of related elements are loaded and shown in the sidebar.',
    name: 'defaultElementTypes',
    values: settings.defaultElementTypes,
    options: [
      {label: 'Entries', value: 'entries'},
      {label: 'Categories', value: 'categories'},
      {label: 'Assets', value: 'assets'},
      {label: 'Tags', value: 'tags'},
    ],
    warning: configFileSettings.defaultElementTypes is defined ? 'This setting is being overridden by the "defaultElementTypes" setting in your related-elements.php config file.' : null,
    disabled: configFileSettings.defaultElementTypes is defined,
  }) }}

  {{ forms.checkboxGroupField({
    label: 'Enabled entry types',
    instructions: 'Choose where the Related Elements sidebar is available.',
    id: 'enabled-entry-types',
    name: 'enabledEntryTypeUids',
    values: settings.enabledEntryTypeUids is empty ? ['*'] : settings.enabledEntryTypeUids,
    options: [{label: 'All entry types', value: '*'}]|merge(entryTypeOptions),
    warning: configFileSettings.enabledEntryTypeUids is defined ? 'This setting is being overridden by the "enabledEntryTypeUids" setting in your related-elements.php config file.' : null,
    disabled: configFileSettings.enabledEntryTypeUids is defined,
  }) }}

  {{ forms.checkboxGroupField({
    label: 'Enabled sections',
    instructions: 'Choose which sections display the Related Elements sidebar.',
    id: 'enabled-sections',
    name: 'enabledSectionUids',
    values: settings.enabledSectionUids is empty ? ['*'] : settings.enabledSectionUids,
    options: [{label: 'All sections', value: '*'}]|merge(sectionOptions),
    warning: configFileSettings.enabledSectionUids is defined ? 'This setting is being overridden by the "enabledSectionUids" setting in your related-elements.php config file.' : null,
    disabled: configFileSettings.enabledSectionUids is defined,
  }) }}
</div>

{% js %}
['enabled-entry-types', 'enabled-sections'].forEach((id) => {
  const group = document.getElementById(`settings-${id}`);
  if (!group) return;
  const checkboxes = Array.from(group.querySelectorAll('input[type="checkbox"]'));
  const all = checkboxes.find((checkbox) => checkbox.value === '*');
  if (!all) return;
  const specific = checkboxes.filter((checkbox) => checkbox !== all);
  specific.forEach((checkbox) => checkbox.dataset.initiallyDisabled = checkbox.disabled ? 'true' : 'false');
  const updateSpecificOptions = () => specific.forEach((checkbox) => {
    checkbox.disabled = all.checked || checkbox.dataset.initiallyDisabled === 'true';
  });
  all.addEventListener('change', () => {
    if (all.checked) specific.forEach((checkbox) => checkbox.checked = false);
    updateSpecificOptions();
  });
  updateSpecificOptions();
});
{% endjs %}
