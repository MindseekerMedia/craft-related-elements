{% set currentField = null %}
{% for item in items %}
  {% if item.fieldLabel and item.fieldLabel != currentField %}
    <div class="field nested-field-header" data-loaded="{{ loaded ? 'true' : 'false' }}"><strong>{{ item.fieldLabel }}</strong></div>
    {% set currentField = item.fieldLabel %}
  {% endif %}
  {% include 'related-elements/_element-item' with {element: item.element, type: item.type, fieldLabel: item.fieldLabel, showElementTypeLabel: showElementTypeLabel, loaded: loaded} only %}
{% endfor %}
